{
  "manifest_version": 3,
  "name": "IG Hidden Mentions",
  "version": "0.4.0",
  "description": "Automatically shows Instagram Story mentions present in locally loaded page data.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open IG Hidden Mentions"
  }
}
